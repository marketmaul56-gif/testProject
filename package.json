{
  "name": "ai-native-skill-learning-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:api": "tsc -p tsconfig.api-build.json",
    "build:worker": "tsc -p tsconfig.worker-build.json",
    "build:verifier-dispatcher": "tsc -p tsconfig.verifier-build.json",
    "test:domain": "node --test tests/unit/*.test.ts",
    "test:security": "node --test tests/security/*.test.ts",
    "test:contract": "node --test tests/contract/*.test.ts",
    "test:e2e": "node --test tests/e2e/*.test.ts",
    "test:failure": "node --test tests/integration/failure-matrix.test.ts",
    "test:performance": "node --test tests/performance/*.test.ts",
    "test:runtime": "node --test tests/integration/runtime-authority-flow.test.ts tests/integration/bullmq-authority-transport.test.ts",
    "test": "pnpm run test:domain && pnpm run test:security && pnpm run test:contract",
    "check": "pnpm run check:architecture && pnpm run typecheck && pnpm run test",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "auth:schema": "auth generate --config packages/platform/auth/src/better-auth.cli.ts --adapter kysely --output prisma/generated/better-auth.sql --yes"
  },
  "dependencies": {
    "@skill-platform/contracts": "workspace:*",
    "@aws-sdk/client-s3": "3.1130.0",
    "@aws-sdk/s3-request-presigner": "3.1130.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.4",
    "bullmq": "6.3.4",
    "cors": "2.8.6",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "auth": "1.7.4",
    "prisma": "7.10.0",
    "typescript": "7.0.2"
  }
}
