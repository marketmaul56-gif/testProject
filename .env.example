# Local-only example values. Never commit real credentials.
NODE_ENV=local
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skill_platform
# Better Auth uses the same PostgreSQL database but an isolated auth schema.
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skill_platform?options=-c%20search_path%3Dauth
BETTER_AUTH_URL=http://localhost:3001
# Generate a high-entropy value of at least 32 characters for real environments.
BETTER_AUTH_SECRET=local-only-change-me-32-characters-minimum
TRUSTED_ORIGINS=http://localhost:3000
# Server-only Next.js → API origin. Never expose this as NEXT_PUBLIC_*.
INTERNAL_API_BASE_URL=http://localhost:3001/api/v1
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=skill-platform-local
OBJECT_STORAGE_ACCESS_KEY=local-only
OBJECT_STORAGE_SECRET_KEY=local-only
# AI Coach is optional. Leave both unset to keep the core product fully usable without AI.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=8000
