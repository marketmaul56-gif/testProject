{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "apps/web/**",
    "packages/platform/db/generated/**",
    "tests/**"
  ]
}
